knitr::opts_chunk$set(echo = TRUE)
library(terra)
library(tidyverse)
library(ggplot2)
library(dplyr)
library(tidyr)
aci15 <- rast("data/ACI2015.tif")
aci20 <- rast("data/ACI2020.tif")
nalcms15 <- rast("data/NALCMS2015.tif")
nalcms20 <- rast("data/NALCMS2020.tif")
target_crs <- "EPSG:26910"
# Project ACI 2015 first (use nearest neighbor for categorical data)
aci15_p <- project(aci15, target_crs, method = "near")
# Force others to same grid using aci15_p as template
aci20_p    <- project(aci20,    aci15_p, method = "near")
nalcms15_p <- project(nalcms15, aci15_p, method = "near")
nalcms20_p <- project(nalcms20, aci15_p, method = "near")
# Replace originals
aci15 <- aci15_p
aci20 <- aci20_p
nalcms15 <- nalcms15_p
nalcms20 <- nalcms20_p
compareGeom(aci15, aci20, stopOnError = FALSE)
compareGeom(aci15, nalcms15, stopOnError = FALSE)
compareGeom(aci15, nalcms20, stopOnError = FALSE)
compareGeom(aci20, nalcms15, stopOnError = FALSE)
compareGeom(aci15, nalcms20, stopOnError = FALSE)
compareGeom(nalcms15, nalcms20, stopOnError = FALSE)
sort(unique(values(aci15)))
sort(unique(values(nalcms15)))
aci15[aci15 == 0] <- NA
aci20[aci20 == 0] <- NA
nalcms15[nalcms15 == 0] <- NA
nalcms20[nalcms20 == 0] <- NA
# recheck target classes
sort(unique(values(aci15)))
sort(unique(values(nalcms15)))
classes <- c("Water","Urban","Annual","Perennial","Forest","Wetland")
make_accuracy_table <- function(cm, classes, row_name = "Classified data (ACI)") {
cm <- as.matrix(cm)
# base confusion matrix
cm_df <- as.data.frame.matrix(cm)
rownames(cm_df) <- classes
colnames(cm_df) <- classes
# row totals
cm_df$Total <- rowSums(cm)
# producer's accuracy = diagonal / reference total = diagonal / column sums
prod_acc <- round(ifelse(colSums(cm) == 0, NA, diag(cm) / colSums(cm) * 100), 1)
# user's accuracy = diagonal / classified total = diagonal / row sums
user_acc <- round(ifelse(rowSums(cm) == 0, NA, diag(cm) / rowSums(cm) * 100), 1)
# add user's accuracy as last column
cm_df$`User's Accuracy (%)` <- user_acc
# move row names into first column
cm_df <- cbind(Class = rownames(cm_df), cm_df)
rownames(cm_df) <- NULL
names(cm_df)[1] <- row_name
# total row
total_row <- data.frame(matrix(NA, nrow = 1, ncol = ncol(cm_df)))
names(total_row) <- names(cm_df)
total_row[1, 1] <- "Total"
total_row[1, 2:(length(classes) + 1)] <- colSums(cm)
total_row[1, length(classes) + 2] <- sum(cm)   # Total column
total_row[1, length(classes) + 3] <- NA        # User's accuracy blank
# producer's accuracy row
prod_row <- data.frame(matrix(NA, nrow = 1, ncol = ncol(cm_df)))
names(prod_row) <- names(cm_df)
prod_row[1, 1] <- "Producer's Accuracy (%)"
prod_row[1, 2:(length(classes) + 1)] <- prod_acc
prod_row[1, length(classes) + 2] <- NA
prod_row[1, length(classes) + 3] <- NA
# overall accuracy row
oa <- round(sum(diag(cm)) / sum(cm) * 100, 1)
oa_row <- data.frame(matrix(NA, nrow = 1, ncol = ncol(cm_df)))
names(oa_row) <- names(cm_df)
oa_row[1, 1] <- "Overall Accuracy (%)"
oa_row[1, 2] <- oa
final_table <- rbind(cm_df, total_row, prod_row, oa_row)
return(final_table)
}
cm15 <- table(
factor(values(aci15), levels = 1:6),
factor(values(nalcms15), levels = 1:6),
useNA = "no"
)
cm15_table <- make_accuracy_table(cm15, classes)
cm15_table
cm20 <- table(
factor(values(aci20), levels = 1:6),
factor(values(nalcms20), levels = 1:6),
useNA = "no"
)
cm20_table <- make_accuracy_table(cm20, classes)
cm20_table
# Overall accuracies from pairwise comparisons
# Overall accuracies from pairwise comparisons (computed above)
oa15 <- sum(diag(cm15)) / sum(cm15)
oa20 <- sum(diag(cm20)) / sum(cm20)
oa15_pct <- round(oa15 * 100, 1)
oa20_pct <- round(oa20 * 100, 1)
# Normalized weights
w15 <- c(ACI = oa15, NALCMS = 1 - oa15)
w20 <- c(ACI = oa20, NALCMS = 1 - oa20)
w15
w20
df <- tibble::tibble(
Year    = factor(c(2015, 2015, 2020, 2020), levels = c(2015, 2020)),
Dataset = factor(c("ACI", "NALCMS", "ACI", "NALCMS"), levels = c("ACI","NALCMS")),
Weight  = c(w15["ACI"], w15["NALCMS"], w20["ACI"], w20["NALCMS"])
)
ndw <- ggplot(df, aes(x = Dataset, y = Year, fill = Weight)) +
geom_tile(color = "white", linewidth = 1.1, width = 0.95, height = 0.95) +
# shadow (draw first, slightly offset)
geom_text(
aes(label = sprintf("%.2f", Weight)),
color = "black", alpha = 0.25,
size = 5, fontface = "bold",
nudge_x = 0.01, nudge_y = -0.01
) +
# main label (draw on top)
geom_text(
aes(label = sprintf("%.2f", Weight)),
color = "white",
size = 5, fontface = "bold"
) +
scale_fill_gradient(
low    = "#D7F0ED",   # lighter teal (more contrast)
high   = "#08306B",   # navy
limits = c(0, 1),
breaks = seq(0, 1, 0.2)
) +
labs(
x = NULL,
y = "Year"
) +
theme_minimal(base_size = 13) +
theme(
panel.grid = element_blank(),
axis.title.y = element_text(margin = margin(r = 8)),
axis.text = element_text(color = "grey25")
)
ndw
ggsave("outputs/normalized_weights.png", ndw, width = 7, height = 4, dpi = 300, bg = "white")
# Harmonization rule:
# 1) If both NA -> NA
# 2) If one NA -> use the other
# 3) If both present:
#    - if agree -> keep class
#    - if disagree -> choose ACI (tie-break)
harmonize_aci <- function(aci, nalcms){
ifel(is.na(aci) & is.na(nalcms), NA,
ifel(is.na(aci) & !is.na(nalcms), nalcms,
ifel(!is.na(aci) & is.na(nalcms), aci,
ifel(aci == nalcms, aci, aci))))
}
harm15 <- harmonize_aci(aci15, nalcms15)
harm20 <- harmonize_aci(aci20, nalcms20)
# enforce valid classes only (1–6)
harm15 <- ifel(harm15 %in% 1:6, harm15, NA)
harm20 <- ifel(harm20 %in% 1:6, harm20, NA)
# check geometry matches input (should be TRUE)
compareGeom(aci15, harm15, stopOnError = FALSE)
compareGeom(aci20, harm20, stopOnError = FALSE)
# check class values present
sort(unique(values(harm15)))
sort(unique(values(harm20)))
# how many valid pixels?
global(!is.na(harm15), "sum", na.rm=TRUE)
global(!is.na(harm20), "sum", na.rm=TRUE)
#dir.create("outputs", showWarnings = FALSE)
names(harm15) <- "harmonized_2015"
writeRaster(harm15, "outputs/Harmonized_2015.tif",
overwrite = TRUE, gdal = c("COMPRESS=LZW"))
names(harm20) <- "harmonized_2020"
writeRaster(harm20, "outputs/Harmonized_2020.tif",
overwrite = TRUE, gdal = c("COMPRESS=LZW"))
lc_cols <- c(
"blue",        # 1 Water
"grey70",      # 2 Urban
"gold",        # 3 Annual agriculture
"darkgreen",   # 4 Perennial agriculture
"forestgreen", # 5 Forest
"turquoise4"   # 6 Wetland
)
lc_labels <- c(
"Water",
"Urban",
"Annual agriculture",
"Perennial agriculture",
"Forest",
"Wetland"
)
par(mfrow = c(1,2), mar = c(3,3,3,5))
plot(harm15,
col = lc_cols,
breaks = seq(0.5, 6.5, by = 1),
legend = FALSE,
main = "Harmonized Land Cover (2015)")
plot(harm20,
col = lc_cols,
breaks = seq(0.5, 6.5, by = 1),
legend = FALSE,
main = "Harmonized Land Cover (2020)")
legend("right",
legend = lc_labels,
inset = c(-0.25, 0),
fill = lc_cols,
cex = 0.8,
bty = "n")
